<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x86</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>Win7POS.Wpf.UiSmokeHarness</AssemblyName>
    <RootNamespace>Win7POS.Wpf.UiSmokeHarness</RootNamespace>
    <StartupObject>Win7POS.Wpf.UiSmokeHarness.Program</StartupObject>
    <!-- Share the product's reviewed ValueTuple redirect with the QA host. -->
    <AppConfig>..\..\src\Win7POS.Wpf\App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Win7POS.Core\Win7POS.Core.csproj" />
    <ProjectReference Include="..\..\src\Win7POS.Data\Win7POS.Data.csproj" />
    <ProjectReference Include="..\..\src\Win7POS.Wpf\Win7POS.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF AfterBuild copy is not propagated through ProjectReference.
         Keep the separately packaged QA host's app-local runtime closure. -->
    <Content Include="$(NuGetPackageRoot)system.valuetuple/4.6.2/lib/net47/System.ValueTuple.dll">
      <Link>System.ValueTuple.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\fixtures\historical-sales-getnet-v1\*">
      <Link>fixtures\historical-sales-getnet-v1\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
