        },
        "mimeType": {
          "const": "image/jpeg"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        }
      }
    },
    "imageRef": {
      "type": "object",
