{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:merchandise-control:contract:pos-product-image-v1",
  "title": "MerchandiseControl trusted POS product image v1",
  "description": "Server-only trusted POS delta over the unchanged portable merchandise-control.product-image.v1 contract.",
  "x-contractId": "merchandise-control.pos-product-image.v1",
  "x-schemaVersion": "pos-product-image-v1",
  "x-portableContract": {
    "id": "merchandise-control.product-image.v1",
    "version": 1,
    "sha256": "b6212f36f27a6dc294713ca7345a29ff8d1a73733b9edb5d8e1a5c3b8ec14672",
    "unchanged": true
  },
  "x-endpoints": {
    "intent": {
      "method": "POST",
      "path": "/api/pos/catalog/product-images/intent",
      "permission": "products.write"
    },
    "finalize": {
      "method": "POST",
      "path": "/api/pos/catalog/product-images/finalize",
      "permission": "products.write"
    },
    "read-urls": {
      "method": "POST",
      "path": "/api/pos/catalog/product-images/read-urls",
      "permission": "products.read"
    },
    "remove": {
      "method": "POST",
      "path": "/api/pos/catalog/product-images/remove",
      "permission": "products.write"
    }
  },
  "x-limits": {
    "jsonBodyMaximumBytes": 16384,
    "readBatchMaximum": 16,
    "readResponseMaximumBytes": 65536,
    "readSignedUrlTtlSeconds": 300,
    "signedUploadCapabilityMaximumSeconds": 7200,
    "mainMaximumBytes": 1048576,
    "thumbMaximumBytes": 92160
  },
  "x-canonicalPayloadHash": {
    "algorithm": "sha256",
    "encoding": "utf-8",
    "format": "sha256:<64-lowercase-hex>",
    "serialization": "compact-json-fixed-key-order",
    "excludedFields": [
      "operationId",
      "idempotencyKey",
      "payloadHash",
      "appVersion",
      "shopDeviceId",
      "staffId",
      "staffCredentialVersion",
      "posSessionId",
      "deviceToken",
      "sessionToken",
      "mainUploadUrl",
      "thumbUploadUrl",
      "signedUrl",
      "storagePath"
    ],
    "operations": {
      "intent": {
        "topLevelFieldOrder": [
          "schemaVersion",
          "operation",
          "shopId",
          "productId",
          "expectedCurrentVersionId",
          "main",
          "thumb"
        ],
        "mainFieldOrder": [
          "bytes",
          "height",
          "mimeType",
          "sha256",
          "width"
        ],
        "thumbFieldOrder": [
          "bytes",
          "height",
          "mimeType",
          "sha256",
          "width"
        ]
      },
      "finalize": {
        "topLevelFieldOrder": [
          "schemaVersion",
          "operation",
          "shopId",
          "productId",
          "expectedCurrentVersionId",
          "versionId"
        ]
      },
      "remove": {
        "topLevelFieldOrder": [
          "schemaVersion",
          "operation",
          "shopId",
          "productId",
          "expectedCurrentVersionId"
        ]
      },
      "read-urls": null
    }
  },
  "x-receiptPolicy": {
    "operations": [
      "intent",
      "finalize",
      "remove"
    ],
    "serviceRoleOnly": true,
    "sameOperationAndHash": "replay-original-durable-outcome",
    "sameOperationDifferentHash": "fail-closed-without-dml",
    "forbiddenFields": [
      "deviceToken",
      "sessionToken",
      "credential",
      "mainUploadUrl",
      "thumbUploadUrl",
      "signedUrl",
      "storagePath",
      "mainPath",
      "thumbPath",
      "requestBody"
    ]
  },
  "x-catalogProductFields": {
    "primaryImageVersionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "primaryImageUpdatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "canonical-timestamp"
    },
    "forbidden": [
      "signedUrl",
      "uploadUrl",
      "storagePath",
      "sha256",
      "bytes",
      "width",
      "height"
    ]
  },
  "oneOf": [
    {
      "$ref": "#/$defs/intentRequest"
    },
    {
      "$ref": "#/$defs/finalizeRequest"
    },
    {
      "$ref": "#/$defs/readUrlsRequest"
    },
    {
      "$ref": "#/$defs/removeRequest"
    },
    {
      "$ref": "#/$defs/intentResponse"
    },
    {
      "$ref": "#/$defs/finalizeResponse"
    },
    {
      "$ref": "#/$defs/readUrlsResponse"
    },
    {
      "$ref": "#/$defs/removeResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,119}$"
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Forward-compatible bounded label. It is not required to be semantic-version formatted and is excluded from payloadHash."
    },
    "secret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "writeOnly": true
    },
    "credentialVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "cacheScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "ephemeralUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri",
      "readOnly": true,
      "description": "HTTPS-only outside loopback tests; never durable, logged, audited or used as identity."
    },
    "mainMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "height",
        "mimeType",
        "sha256",
        "width"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        },
        "mimeType": {
          "const": "image/jpeg"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        }
      }
    },
    "thumbMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "height",
        "mimeType",
        "sha256",
        "width"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 92160
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384
        },
        "mimeType": {
          "const": "image/jpeg"
        },
        "sha256": {
          "$ref": "#/$defs/sha256Hex"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384
        }
      }
    },
    "readMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "height",
        "mimeType",
        "sha256",
        "width"
