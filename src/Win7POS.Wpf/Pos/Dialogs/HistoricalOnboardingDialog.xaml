<chrome:DialogShellWindow x:Class="Win7POS.Wpf.Pos.Dialogs.HistoricalOnboardingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:Win7POS.Wpf.Chrome"
    xmlns:loc="clr-namespace:Win7POS.Wpf.Localization"
    Title="{loc:Loc history.onboardingTitle}" WindowStartupLocation="CenterOwner"
    ShowHeader="False" UseModalOverlay="True" SizeToContent="WidthAndHeight"
    MinWidth="480" MaxWidth="640" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel>
        <TextBlock Text="{loc:Loc history.onboardingTitle}" Style="{StaticResource DialogTitleStyle}"/>
        <StackPanel Margin="20,12">
            <TextBlock x:Name="StatusText" Text="{loc:Loc history.onboardingAvailable}" TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="ImportButton" Content="{loc:Loc history.title}" Margin="0,18,0,8" Height="44"
                Style="{StaticResource DialogActionButtonStyle}" Click="OnImportClick"
                AutomationProperties.AutomationId="HistoryOnboarding.Import"/>
            <Button x:Name="ReportButton" Content="{loc:Loc historyReport.analyticalTitle}" Height="44"
                Style="{StaticResource DialogActionButtonStyle}" Click="OnReportClick"
                AutomationProperties.AutomationId="HistoryOnboarding.Report"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterMargin}">
            <Button MinWidth="100" Height="42" IsCancel="True" Content="{loc:Loc common.close}"
                Style="{StaticResource DialogCancelButtonStyle}" Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</chrome:DialogShellWindow>
