<chrome:DialogShellWindow x:Class="Win7POS.Wpf.Pos.Dialogs.CartViewSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Win7POS.Wpf.Chrome"
        xmlns:loc="clr-namespace:Win7POS.Wpf.Localization"
        Title="{loc:Loc settings.cartView.title}"
        ShowHeader="False"
        UseModalOverlay="True"
        DialogCornerRadius="16"
        DialogBackground="#F1EDF7"
        DialogBorderBrush="#D9CEE8"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Background="#F1EDF7" FocusManager.FocusedElement="{Binding ElementName=RowsOption}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc settings.cartView.title}" Style="{StaticResource DialogTitleStyle}"/>
            <TextBlock Text="{loc:Loc settings.cartView.dialogHelp}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#FCFBFE"
                BorderBrush="#D9CEE8"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,10">
            <RadioButton x:Name="RowsOption" GroupName="CartViewMode">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{loc:Loc settings.cartView.rows}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc settings.cartView.recommended}"
                               Foreground="#6A4B7A"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0"/>
                    <TextBlock Text="{loc:Loc settings.cartView.rowsDescription}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
        </Border>

        <Border Grid.Row="2"
                Background="#FCFBFE"
                BorderBrush="#D9CEE8"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <RadioButton x:Name="GridOption" GroupName="CartViewMode">
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{loc:Loc settings.cartView.grid}" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc settings.cartView.gridDescription}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{loc:Loc settings.cartView.lowPowerNote}"
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{StaticResource DialogFooterMargin}">
                <Button Style="{StaticResource DialogActionButtonStyle}"
                        IsDefault="True"
                        Click="OnApplyClick"
                        Margin="0,0,8,0">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc common.apply}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DialogCancelButtonStyle}"
                        IsCancel="True"
                        Click="OnCloseClick">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconClear}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc common.close}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</chrome:DialogShellWindow>
