<chrome:DialogShellWindow x:Class="Win7POS.Wpf.Pos.Dialogs.DbMaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Win7POS.Wpf.Chrome"
        xmlns:loc="clr-namespace:Win7POS.Wpf.Localization"
        Title="{Binding Source={x:Static loc:PosLocalization.Current}, Path=[dbMaintenance.title]}"
        ShowHeader="False"
        DialogCornerRadius="16"
        DialogBackground="#F1EDF7"
        DialogBorderBrush="#D9CEE8"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        Width="680"
        Height="520"
        MinWidth="640"
        MinHeight="460"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="0" Background="#F1EDF7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{loc:Loc dbMaintenance.title}" Style="{StaticResource DialogTitleStyle}" Margin="0,0,0,10"/>
        <Border Grid.Row="1" Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabelTextStyle}" Margin="0,0,8,0" Text="{loc:Loc dbMaintenance.dbPath}"/>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ReadOnlyInfoValueBorderStyle}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding DbPath, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoValueTextStyle}"/>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabelTextStyle}" Margin="0,6,8,0" Text="{loc:Loc dbMaintenance.backupsDirectory}"/>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ReadOnlyInfoValueBorderStyle}" Margin="8,6,0,0">
                        <TextBlock Text="{Binding BackupsDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoValueTextStyle}"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabelTextStyle}" Margin="0,6,8,0" Text="{loc:Loc dbMaintenance.exportsDirectory}"/>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ReadOnlyInfoValueBorderStyle}" Margin="8,6,0,0">
                        <TextBlock Text="{Binding ExportsDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoValueTextStyle}"/>
                    </Border>

                    <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Button x:Name="BackupNowButton" MinWidth="132" Height="36" Margin="0,0,8,8" Command="{Binding BackupNowCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.BackupNow" AutomationProperties.Name="{loc:Loc dbMaintenance.backupNow}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconDatabase}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc dbMaintenance.backupNow}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestoreBackupButton" MinWidth="150" Height="36" Margin="0,0,8,8" Command="{Binding RestoreBackupCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.Restore" AutomationProperties.Name="{loc:Loc dbMaintenance.restoreBackup}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconImport}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc dbMaintenance.restoreBackup}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button MinWidth="142" Height="36" Margin="0,0,8,8" Command="{Binding IntegrityCheckCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.IntegrityCheck" AutomationProperties.Name="{loc:Loc dbMaintenance.integrityCheck}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconSearch}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc dbMaintenance.integrityCheck}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button MinWidth="190" Height="36" Margin="0,0,8,8" Content="{loc:Loc dbMaintenance.completeRestoreReview}" Command="{Binding CompleteRestoreReviewCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.CompleteRestoreReview" AutomationProperties.Name="{loc:Loc dbMaintenance.completeRestoreReview}"/>
                        <Button x:Name="VacuumButton" MinWidth="110" Height="36" Margin="0,0,8,8" Command="{Binding VacuumCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.Vacuum" AutomationProperties.Name="VACUUM">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconClear}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="VACUUM" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SupplierImportButton" MinWidth="178" Height="36" Margin="0,0,8,8" Command="{Binding SupplierExcelImportCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.SupplierImport" AutomationProperties.Name="{loc:Loc supplierExcelImport.title}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconImport}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc supplierExcelImport.title}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenFolderButton" MinWidth="132" Height="36" Margin="0,0,8,8" Command="{Binding OpenFolderCommand}" Style="{StaticResource OutlineButtonStyle}"
                                AutomationProperties.AutomationId="DbMaintenance.OpenFolder" AutomationProperties.Name="{loc:Loc dbMaintenance.openFolder}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconGo}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc dbMaintenance.openFolder}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel x:Name="BackupAutomationPanel" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,12">
                        <TextBlock Text="{loc:Loc backupAutomation.title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid IsEnabled="{Binding BackupSettingsLoaded}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc backupAutomation.schedule}" Style="{StaticResource FormLabelTextStyle}"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,6" ItemsSource="{Binding BackupSchedules}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding BackupSchedule}" AutomationProperties.AutomationId="DbMaintenance.BackupSchedule"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc backupAutomation.time}" Style="{StaticResource FormLabelTextStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,6" MaxLength="5" Text="{Binding BackupTime, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" AutomationProperties.AutomationId="DbMaintenance.BackupTime"/>
                            <TextBlock Grid.Row="2" Text="{loc:Loc backupAutomation.weekday}" Style="{StaticResource FormLabelTextStyle}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,6" ItemsSource="{Binding BackupWeekdays}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding BackupWeeklyDay}" AutomationProperties.AutomationId="DbMaintenance.BackupWeekday"/>
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="{loc:Loc backupAutomation.catchUp}" IsChecked="{Binding BackupCatchUp}"/>
                            <TextBlock Grid.Row="4" Text="{loc:Loc backupAutomation.retention}" Style="{StaticResource FormLabelTextStyle}"/>
                            <WrapPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,6">
                                <TextBox Width="60" MaxLength="3" Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                         AutomationProperties.AutomationId="DbMaintenance.BackupRetentionCount"/>
                                <TextBlock Text="{loc:Loc backupAutomation.files}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                <TextBox Width="65" MaxLength="4" Text="{Binding BackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                         AutomationProperties.AutomationId="DbMaintenance.BackupRetentionDays"/>
                                <TextBlock Text="{loc:Loc backupAutomation.days}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="5" Text="{loc:Loc backupAutomation.destination}" Style="{StaticResource FormLabelTextStyle}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="8,0,0,6" ItemsSource="{Binding BackupDestinations}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding BackupDestinationKind}" AutomationProperties.AutomationId="DbMaintenance.BackupDestinationKind"/>
                            <TextBlock Grid.Row="6" Text="{loc:Loc backupAutomation.path}" Style="{StaticResource FormLabelTextStyle}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Margin="8,0,0,6" Text="{Binding BackupDestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" AutomationProperties.AutomationId="DbMaintenance.BackupDestinationPath"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc backupAutomation.help}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,8"/>
                        <Button HorizontalAlignment="Left" MinWidth="132" Height="36" Content="{loc:Loc backupAutomation.save}" Command="{Binding SaveBackupSettingsCommand}"
                                Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.SaveBackupSettings"/>
                        <TextBlock Text="{loc:Loc backupAutomation.lastResult}" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding LastBackupResult}" TextWrapping="Wrap" AutomationProperties.AutomationId="DbMaintenance.LastBackupResult" AutomationProperties.LiveSetting="Polite"/>
                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="{loc:Loc settingsProfile.title}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{loc:Loc settingsProfile.help}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="{loc:Loc settingsProfile.export}" Command="{Binding ExportProfileCommand}" Height="36" Margin="0,0,8,8" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.ExportSettingsProfile"/>
                            <Button Content="{loc:Loc settingsProfile.preview}" Command="{Binding PreviewProfileCommand}" Height="36" Margin="0,0,8,8" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.PreviewSettingsProfile"/>
                            <Button Content="{loc:Loc settingsProfile.apply}" Command="{Binding ApplyProfileCommand}" Height="36" Margin="0,0,8,8" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.ApplySettingsProfile"/>
                            <Button Content="{loc:Loc settingsProfile.audit}" Command="{Binding ViewSettingsAuditCommand}" Height="36" Margin="0,0,8,8" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.SettingsAudit"/>
                        </WrapPanel>
                        <TextBox Text="{Binding ProfilePreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernTextBoxStyle}" AutomationProperties.AutomationId="DbMaintenance.SettingsProfileDiff"/>
                        <WrapPanel Margin="0,8,0,0">
                            <ComboBox Width="190" ItemsSource="{Binding DefaultsScopes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DefaultsScope}" Margin="0,0,8,0" AutomationProperties.AutomationId="DbMaintenance.DefaultsScope"/>
                            <Button Content="{loc:Loc settingsProfile.reset}" Command="{Binding RestoreDefaultsCommand}" Height="36" Padding="12,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.AutomationId="DbMaintenance.ResetSettingsDefaults"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,0" Foreground="DimGray" Text="{loc:Loc dbMaintenance.outputResults}"/>
                    <Grid Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0" MinHeight="120">
                        <TextBox Text="{Binding OutputLog}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 AutomationProperties.AutomationId="DbMaintenance.Output"
                                 AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Margin="12"
                                   Text="{loc:Loc dbMaintenance.noResultsYet}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasOutputLog, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
                <Border Background="#E6FCFBFE"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="DbMaintenance.BusyState"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Height="6" IsIndeterminate="True"/>
                        <TextBlock Margin="0,12,0,0"
                                   Text="{loc:Loc dbMaintenance.operationInProgress}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterMargin}">
            <Button MinWidth="110" Height="42" IsCancel="True" Style="{StaticResource DialogCancelButtonStyle}" Click="Close_Click"
                    AutomationProperties.AutomationId="DbMaintenance.Close" AutomationProperties.Name="{loc:Loc common.close}">
                <StackPanel Style="{StaticResource IconButtonContent}">
                    <Path Data="{StaticResource IconClear}" Style="{StaticResource ButtonIconPathStyle}"/>
                    <TextBlock Text="{loc:Loc common.close}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</chrome:DialogShellWindow>
