<chrome:DialogShellWindow x:Class="Win7POS.Wpf.Import.SupplierExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Win7POS.Wpf.Chrome"
        xmlns:loc="clr-namespace:Win7POS.Wpf.Localization"
        Title="{Binding Source={x:Static loc:PosLocalization.Current}, Path=[supplierExcelImport.title]}"
        ShowHeader="False"
        UseModalOverlay="True"
        DialogCornerRadius="16"
        DialogBackground="#F1EDF7"
        DialogBorderBrush="#D9CEE8"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Manual"
        Width="1040"
        Height="720"
        MaxWidth="1120"
        MaxHeight="720"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <chrome:DialogShellWindow.Resources>
        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <Style x:Key="SupplierImportStepBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="SupplierImportStepTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </chrome:DialogShellWindow.Resources>
    <Grid Margin="0" Background="#F1EDF7" FocusManager.FocusedElement="{Binding ElementName=BrowseButton}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc supplierExcelImport.title}" Style="{StaticResource DialogTitleStyle}"/>

        <Border Grid.Row="1" Margin="0,10,0,12" Padding="8" CornerRadius="8"
                Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1"
                AutomationProperties.AutomationId="SupplierImport.StepIndicator">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SupplierImportStepBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc supplierExcelImport.stepChooseFile}" Style="{StaticResource SupplierImportStepTextStyle}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{loc:Loc supplierExcelImport.stepCurrent}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SupplierImportStepBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc supplierExcelImport.stepAnalyzeColumns}" Style="{StaticResource SupplierImportStepTextStyle}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{loc:Loc supplierExcelImport.stepCurrent}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SupplierImportStepBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc supplierExcelImport.stepFixRows}" Style="{StaticResource SupplierImportStepTextStyle}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{loc:Loc supplierExcelImport.stepCurrent}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource SupplierImportStepBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc supplierExcelImport.stepVerifySync}" Style="{StaticResource SupplierImportStepTextStyle}"/>
                        <TextBlock Margin="0,2,0,0"
                                   Text="{loc:Loc supplierExcelImport.stepCurrent}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
        <Grid>
            <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <Border Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc supplierExcelImport.chooseFilePrompt}" FontSize="15" FontWeight="SemiBold"/>
                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BrowseButton"
                                    MinWidth="180"
                                    Height="42"
                                    Command="{Binding BrowseCommand}"
                                    Style="{StaticResource DialogActionButtonStyle}"
                                    AutomationProperties.AutomationId="SupplierImport.Browse"
                                    AutomationProperties.Name="{loc:Loc supplierExcelImport.chooseExcelButton}">
                                <StackPanel Style="{StaticResource IconButtonContent}">
                                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource ButtonIconPathStyle}"/>
                                    <TextBlock Text="{loc:Loc supplierExcelImport.chooseExcelButton}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBox Grid.Column="1"
                                     Margin="14,0,0,0"
                                     Height="42"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedPath}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,18,0,0">
                            <TextBlock Foreground="#6B5B73"
                                       TextWrapping="Wrap"
                                       Text="{loc:Loc supplierExcelImport.flowHelp}"/>
                            <TextBlock Margin="0,16,0,0" Foreground="#5E3F86">
                                <Run Text="{loc:Loc supplierExcelImport.sheetDetected}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedSheetName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#5E3F86"
                                       Text="{Binding HeaderSummary}"/>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#5E3F86"
                                       Text="{Binding RowSummary}"/>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#5E3F86"
                                       Text="{Binding IssueSummary}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.sheet}"/><Run Text=" "/><Run Text="{Binding SelectedSheetName, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabNew}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding NewProductsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabUpdates}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding UpdatedProductsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.warnings}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding WarningsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock><Run Text="{loc:Loc supplierExcelImport.errors}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding ErrorsCount, Mode=OneWay}"/></TextBlock>
	                        </WrapPanel>
	                        <WrapPanel Margin="0,8,0,0">
	                            <TextBlock Margin="0,0,16,0" Text="{Binding HeaderSummary}"/>
	                            <TextBlock Text="{Binding RowSummary}"/>
	                        </WrapPanel>
	                        <TextBlock Margin="0,8,0,0"
	                                   Foreground="#6B5B73"
	                                   TextWrapping="Wrap"
                                   Text="{loc:Loc supplierExcelImport.requiredColumnsHelp}"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="ColumnMappingGrid"
                          ItemsSource="{Binding Columns}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          AutomationProperties.AutomationId="SupplierImport.ColumnMappingGrid"
                          AutomationProperties.Name="{loc:Loc supplierExcelImport.stepAnalyzeColumns}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{loc:Loc supplierExcelImport.columnEnabled}" Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.columnOriginalName}" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTemplateColumn Header="{loc:Loc supplierExcelImport.columnCanonicalKey}" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ColumnKeyOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding CanonicalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ColumnKeyOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding CanonicalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.columnHeaderSource}" Binding="{Binding HeaderSource}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.columnConfidence}" Binding="{Binding Confidence}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.columnSampleValues}" Binding="{Binding SampleValues}" IsReadOnly="True" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="{loc:Loc supplierExcelImport.warnings}" Margin="0,0,6,0">
                        <DataGrid ItemsSource="{Binding Warnings}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueRows}" Binding="{Binding RowsDisplay}" Width="85"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueMessage}" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="{loc:Loc supplierExcelImport.errors}" Margin="6,0,0,0">
                        <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueRows}" Binding="{Binding RowsDisplay}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueMessage}" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              MaxHeight="160"
                              Margin="0,0,0,10"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="10"
                            Background="#FFF8E1"
                            BorderBrush="#F0C36D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasRetailPriceWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.retailPriceWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="#7A4A00"/>
                    </Border>
                    <Border Margin="0,6,0,0"
                            Padding="10"
                            Background="#FFF8E1"
                            BorderBrush="#F0C36D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasBarcodeWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.barcodeWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="#7A4A00"/>
                    </Border>
                    <Border Margin="0,6,0,0"
                            Padding="10"
                            Background="#FFF8E1"
                            BorderBrush="#F0C36D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasIdentityWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.identityWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="#7A4A00"/>
                    </Border>
                    <Border Margin="0,6,0,0"
                            Padding="10"
                            Background="#FFF8E1"
                            BorderBrush="#F0C36D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasInvalidNumberWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.invalidNumberWarning}"
                                   TextWrapping="Wrap"
                                   Foreground="#7A4A00"/>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Margin="0,0,0,10" Padding="10" Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1" CornerRadius="8">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc supplierExcelImport.markupTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.markupPercent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="70" Height="32" Text="{Binding MarkupPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.roundTo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="80" Height="32" ItemsSource="{Binding RoundToOptions}" SelectedItem="{Binding RoundTo, Mode=TwoWay}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0"/>
                        <CheckBox Content="{loc:Loc supplierExcelImport.onlyEmptyRetailPrice}" IsChecked="{Binding ApplyOnlyEmptyRetailPrice, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button MinWidth="120" Height="34" Command="{Binding ApplyMarkupCommand}" Style="{StaticResource DialogActionButtonStyle}">
                            <StackPanel Style="{StaticResource IconButtonContent}">
                                <Path Data="{StaticResource IconGo}" Style="{StaticResource ButtonIconPathStyle}"/>
                                <TextBlock Text="{loc:Loc supplierExcelImport.applyMarkup}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <DataGrid Grid.Row="2"
                          x:Name="EditableRowsGrid"
                          ItemsSource="{Binding EditableRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
	                      GridLinesVisibility="Horizontal"
                          AutomationProperties.AutomationId="SupplierImport.EditableRowsGrid"
                          AutomationProperties.Name="{loc:Loc supplierExcelImport.stepFixRows}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{loc:Loc supplierExcelImport.fieldSkip}" Binding="{Binding IsSkipped, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldItemNumber}" Binding="{Binding ItemNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldProductName}" Binding="{Binding ProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSecondProductName}" Binding="{Binding SecondProductName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldPurchasePrice}" Binding="{Binding PurchasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRetailPrice}" Binding="{Binding RetailPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldQuantity}" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSupplier}" Binding="{Binding Supplier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldCategory}" Binding="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Border Padding="10"
                            Background="#FFF8E1"
                            BorderBrush="#F0C36D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding IsSyncPreviewStale, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.syncPreviewStale}"
                                   TextWrapping="Wrap"
                                   Foreground="#7A4A00"/>
                    </Border>
                    <Border Margin="0,6,0,0" Padding="12" Background="#FCFBFE" BorderBrush="#E4DBEF" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc supplierExcelImport.verifySyncDatabase}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{loc:Loc supplierExcelImport.verifySyncHelp}"
                                       TextWrapping="Wrap"
                                       Foreground="#6B5B73"/>
                            <WrapPanel Margin="0,10,0,0">
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc common.total}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncTotalRowsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabNew}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncNewProductsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabUpdates}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncUpdatedProductsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabNoChanges}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncNoChangeRowsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.tabSkipped}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncSkippedRowsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock Margin="0,0,16,0"><Run Text="{loc:Loc supplierExcelImport.warnings}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncWarningsCount, Mode=OneWay}"/></TextBlock>
	                            <TextBlock><Run Text="{loc:Loc supplierExcelImport.errors}"/><Run Text=":"/><Run Text=" "/><Run Text="{Binding SyncErrorsCount, Mode=OneWay}"/></TextBlock>
                            </WrapPanel>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="{loc:Loc supplierExcelImport.search}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox MinWidth="260"
                                         Height="32"
                                         Text="{Binding SyncSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         AutomationProperties.AutomationId="SupplierImport.ReviewSearch"
                                         AutomationProperties.Name="{loc:Loc supplierExcelImport.search}"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TabControl Grid.Row="1"
                            x:Name="ReviewTabs"
                            AutomationProperties.AutomationId="SupplierImport.ReviewTabs"
                            AutomationProperties.Name="{loc:Loc supplierExcelImport.stepVerifySync}">
                    <TabItem Header="{loc:Loc supplierExcelImport.tabNew}">
                        <DataGrid ItemsSource="{Binding SyncNewProductsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRow}" Binding="{Binding RowNumber}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldItemNumber}" Binding="{Binding ItemNumber}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldProductName}" Binding="{Binding ProductName}" Width="220"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSecondProductName}" Binding="{Binding SecondProductName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRetailPrice}" Binding="{Binding RetailPrice}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldPurchasePrice}" Binding="{Binding PurchasePrice}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldQuantity}" Binding="{Binding Quantity}" Width="90"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSupplier}" Binding="{Binding Supplier}" Width="140"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldCategory}" Binding="{Binding Category}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{loc:Loc supplierExcelImport.tabUpdates}">
                        <DataGrid ItemsSource="{Binding SyncUpdatedProductsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRow}" Binding="{Binding RowNumber}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBeforeProductName}" Binding="{Binding Existing.ProductName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldAfterProductName}" Binding="{Binding Updated.ProductName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldAfterSecondProductName}" Binding="{Binding Updated.SecondProductName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBeforeRetailPrice}" Binding="{Binding Existing.RetailPrice}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldAfterRetailPrice}" Binding="{Binding Updated.RetailPrice}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldDiff}" Binding="{Binding DiffSummary}" Width="4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{loc:Loc supplierExcelImport.tabNoChanges}">
                        <DataGrid ItemsSource="{Binding SyncNoChangeRowsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRow}" Binding="{Binding RowNumber}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldProductName}" Binding="{Binding Updated.ProductName}" Width="220"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSecondProductName}" Binding="{Binding Updated.SecondProductName}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldRetailPrice}" Binding="{Binding Updated.RetailPrice}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldQuantity}" Binding="{Binding Updated.Quantity}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{loc:Loc supplierExcelImport.tabSkipped}">
                        <DataGrid ItemsSource="{Binding SyncSkippedRowsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldOriginalRow}" Binding="{Binding RowNumber}" Width="100"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="160"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldItemNumber}" Binding="{Binding ItemNumber}" Width="160"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldProductName}" Binding="{Binding ProductName}" Width="240"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldSecondProductName}" Binding="{Binding SecondProductName}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{loc:Loc supplierExcelImport.warnings}">
                        <DataGrid ItemsSource="{Binding SyncWarningsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueMessage}" Binding="{Binding Message}" Width="3*"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueRows}" Binding="{Binding RowsDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{loc:Loc supplierExcelImport.errors}">
                        <DataGrid ItemsSource="{Binding SyncErrorsView}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueMessage}" Binding="{Binding Message}" Width="3*"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.issueRows}" Binding="{Binding RowsDisplay}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc supplierExcelImport.fieldBarcode}" Binding="{Binding Barcode}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
            <Border Background="#E6FCFBFE"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="SupplierImport.BusyState"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Height="6" IsIndeterminate="True"/>
                    <TextBlock Margin="0,14,0,0"
                               Text="{Binding Status}"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="{loc:Loc supplierExcelImport.busyHelp}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="{StaticResource DialogFooterMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#5E3F86"
                       AutomationProperties.AutomationId="SupplierImport.Status"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" MinWidth="100" Height="42" Margin="0,0,8,0"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource DialogCancelButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.Back"
                        AutomationProperties.Name="{loc:Loc supplierExcelImport.back}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconPrev}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.back}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AnalyzeButton" MinWidth="100" Height="42" Margin="0,0,8,0"
                        Command="{Binding AnalyzeCommand}"
                        Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}"
                        IsDefault="True"
                        Style="{StaticResource DialogActionButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.Analyze"
                        AutomationProperties.Name="{loc:Loc supplierExcelImport.analyze}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconSearch}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.analyze}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="NextButton" MinWidth="100" Height="42" Margin="0,0,8,0"
                        Command="{Binding NextCommand}"
                        Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}"
                        IsDefault="True"
                        Style="{StaticResource DialogActionButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.Next"
                        AutomationProperties.Name="{loc:Loc supplierExcelImport.next}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <TextBlock Text="{loc:Loc supplierExcelImport.next}" Margin="0,0,8,0"/>
                        <Path Data="{StaticResource IconNext}" Style="{StaticResource ButtonIconPathStyle}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SyncPreviewButton" MinWidth="150" Height="42" Margin="0,0,8,0"
                        Command="{Binding SyncPreviewCommand}"
                        Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}"
                        IsDefault="True"
                        Style="{StaticResource DialogActionButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.SyncPreview"
                        AutomationProperties.Name="{loc:Loc supplierExcelImport.continueSyncDb}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconSync}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.continueSyncDb}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ApplyButton" MinWidth="150" Height="42" Margin="0,0,8,0"
                        Command="{Binding ApplyCommand}"
                        Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}"
                        IsDefault="True"
                        Style="{StaticResource DialogActionButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.Apply"
                        AutomationProperties.Name="{loc:Loc supplierExcelImport.confirmApply}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconImport}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc supplierExcelImport.confirmApply}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" MinWidth="100" Height="42" IsCancel="True"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DialogCancelButtonStyle}"
                        AutomationProperties.AutomationId="SupplierImport.Cancel"
                        AutomationProperties.Name="{loc:Loc common.cancel}">
                    <StackPanel Style="{StaticResource IconButtonContent}">
                        <Path Data="{StaticResource IconClear}" Style="{StaticResource ButtonIconPathStyle}"/>
                        <TextBlock Text="{loc:Loc common.cancel}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</chrome:DialogShellWindow>
