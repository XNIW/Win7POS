<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x86</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x86</Platform>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>8.0</LangVersion>
    <AdminWebEnvironment Condition="'$(AdminWebEnvironment)' == ''">staging</AdminWebEnvironment>
    <AdminWebDefaultBaseUrl Condition="'$(AdminWebDefaultBaseUrl)' == ''">https://merchandise-control-admin-web-staging.merchandise-control-admin-web.workers.dev</AdminWebDefaultBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Win7POS.Wpf.UiSmokeHarness</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AdminWebEnvironment</_Parameter1>
      <_Parameter2>$(AdminWebEnvironment)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AdminWebDefaultBaseUrl</_Parameter1>
      <_Parameter2>$(AdminWebDefaultBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.16" />
    <ProjectReference Include="..\Win7POS.Core\Win7POS.Core.csproj" />
    <ProjectReference Include="..\Win7POS.Data\Win7POS.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ValueTuple 4.6.2 intentionally omits a net471+ runtime asset. Ship its
         pinned net47 forwarder for the reviewed app-local closure and bindings. -->
    <Reference Include="System.ValueTuple, Version=4.0.5.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51">
      <HintPath>$(NuGetPackageRoot)system.valuetuple/4.6.2/lib/net47/System.ValueTuple.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\sii_qrcode.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireWin7PosValueTupleForwarder" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(NuGetPackageRoot)system.valuetuple/4.6.2/lib/net47/System.ValueTuple.dll')"
           Text="Pinned System.ValueTuple 4.6.2 net47 forwarder is missing; restore the locked graph." />
  </Target>
  <Target Name="CopyWin7PosValueTupleForwarder" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(NuGetPackageRoot)system.valuetuple/4.6.2/lib/net47/System.ValueTuple.dll"
          DestinationFiles="$(TargetDir)System.ValueTuple.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
